 "html": "<style>\r\n    .customer-details {\r\n        width: 100%;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    .customer-details .panel {\r\n        width: 100%;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    .customer-details .form-control {\r\n        width: 100%;\r\n        box-sizing: border-box;\r\n    }\r\n</style>\r\n\r\n<div class=\"customer-details\">\r\n    <div class=\"panel panel-default\">\r\n        <div class=\"panel-body\">\r\n\r\n            <div class=\"form-group\">\r\n                <label>Customer Name</label>\r\n                <input type=\"text\"\r\n                       class=\"form-control\"\r\n                       value=\"{{ doc.customer_name }}\"\r\n                       readonly>\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label>Company Type</label>\r\n                <input type=\"text\"\r\n                       class=\"form-control\"\r\n                       value=\"{{ doc.company_type }}\"\r\n                       readonly>\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label>Company Group</label>\r\n                <input type=\"text\"\r\n                       class=\"form-control\"\r\n                       value=\"{{ doc.company_group }}\"\r\n                       readonly>\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label>Territory</label>\r\n                <input type=\"text\"\r\n                       class=\"form-control\"\r\n                       value=\"{{ doc.territory }}\"\r\n                       readonly>\r\n            </div>\r\n\r\n        </div>\r\n    </div>\r\n</div>",
